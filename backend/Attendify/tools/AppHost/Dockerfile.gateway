FROM node:22-alpine AS frontend

WORKDIR /app
COPY webapp/Attendify/package.json webapp/Attendify/package-lock.json ./
RUN npm ci
COPY webapp/Attendify/ ./

ARG VITE_PRIVACY_POLICY_CONTROLLER_NAME
ARG VITE_PRIVACY_POLICY_CONTROLLER_ADDRESS
ARG VITE_PRIVACY_POLICY_CONTROLLER_EMAIL
ARG VITE_PRIVACY_POLICY_DPO_CONTACT
ARG VITE_PRIVACY_POLICY_AUTHORITY_NAME
ARG VITE_PRIVACY_POLICY_AUTHORITY_URL

ENV VITE_PRIVACY_POLICY_CONTROLLER_NAME=$VITE_PRIVACY_POLICY_CONTROLLER_NAME \
    VITE_PRIVACY_POLICY_CONTROLLER_ADDRESS=$VITE_PRIVACY_POLICY_CONTROLLER_ADDRESS \
    VITE_PRIVACY_POLICY_CONTROLLER_EMAIL=$VITE_PRIVACY_POLICY_CONTROLLER_EMAIL \
    VITE_PRIVACY_POLICY_DPO_CONTACT=$VITE_PRIVACY_POLICY_DPO_CONTACT \
    VITE_PRIVACY_POLICY_AUTHORITY_NAME=$VITE_PRIVACY_POLICY_AUTHORITY_NAME \
    VITE_PRIVACY_POLICY_AUTHORITY_URL=$VITE_PRIVACY_POLICY_AUTHORITY_URL

RUN npm run build

FROM caddy:2-alpine

COPY backend/Attendify/tools/AppHost/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend /app/dist /srv
